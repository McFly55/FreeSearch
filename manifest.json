{
  "manifest_version": 3,
  "name": "SearXNG Switcher",
  "version": "1.0.0",
  "description": "Zeigt unten links einen zweigeteilten Button auf SearXNG und anderen Suchmaschinen, um den aktuellen Suchbegriff mit einer anderen Suchmaschine zu suchen.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
